# America Shines Cleaning Service, LLC — Environment Configuration
# Copy this file to .env.local to configure live quote request dispatch and site domain.
# NEVER commit .env.local or production secrets to version control.

# Resend API Key for live email dispatch (obtain from https://resend.com)
# When left empty, quote requests return a clear 503 status directing users to call directly.
RESEND_API_KEY=

# Owner-authorized recipient email address where quote inquiries should be routed
# NOTE: Treat directory emails as unconfirmed until approved by the business owner.
QUOTE_NOTIFICATION_EMAIL=owner-authorized-email@example.com

# Verified sender email address configured in Resend (e.g. quotes@yourdomain.com or onboarding@resend.dev)
RESEND_FROM_EMAIL=America Shines Quotes <onboarding@resend.dev>

# Confirmed public site URL (leave blank for preview or specify your Vercel deployment URL)
# Example: https://americashines-preview.vercel.app
NEXT_PUBLIC_SITE_URL=

# Search engine crawler indexing flag (set to 'true' only after business owner approval)
ENABLE_INDEXING=false
